# ==========================================
# VARIÁVEIS DE AMBIENTE — gerador-painel
# Copie este arquivo para .env e preencha os valores
# ==========================================

# ---------- Bot do Telegram ----------
# 1. Token do bot (pegue com o @BotFather no Telegram)
TELEGRAM_BOT_TOKEN=seu_bot_token_aqui

# --- Bot de Alertas de Vendas (OPCIONAL, recomendado) ---
# 2. Crie um SEGUNDO bot no @BotFather, pegue o token e cole aqui.
#    Ele envia a mensagem "🎉 Nova Compra!" a cada venda.
#    Se deixar VAZIO, usa o mesmo token do TELEGRAM_BOT_TOKEN acima.
NOTIFIER_BOT_TOKEN=

# 3. Seu ID do Telegram (o DONO recebe os alertas). Pegue com /me no bot.
#    É o mesmo ID em qualquer bot. Ex: 123456789
NOTIFY_CHAT_ID=

# 3.1 (OPCIONAL) Chat SEPARADO só do admin (ex: seu chat privado).
#    Se preenchido com um ID diferente de NOTIFY_CHAT_ID:
#    - NOTIFY_CHAT_ID recebe a notificação SEM revendedor/lucro (pode ser grupo/canal público)
#    - NOTIFY_ADMIN_CHAT_ID recebe a versão completa COM o revendedor (só você vê)
#    Se deixar vazio, a versão completa (com revendedor) vai só para NOTIFY_CHAT_ID.
NOTIFY_ADMIN_CHAT_ID=

# 2. Endereço da API (localhost:3000 no PC / https://<app>.onrender.com no Render)
#    Se deixar vazio, o bot tenta usar RENDER_EXTERNAL_URL automaticamente.
API_BASE_URL=http://localhost:3000

# 3. Chave de API do Revendedor (copie no painel http://localhost:3000/revendedor.html)
RESELLER_API_KEY=rev_key_sua_chave_aqui

# 4. Preço que você cobra do cliente final (ex: R$ 15,00)
DEFAULT_SALE_PRICE=15.00

# 5. Usuário de suporte no Telegram (opcional)
SUPPORT_USER=@seu_suporte

# ---------- Banco de dados ----------
# Se estiver VAZIO -> usa SQLite local (database.sqlite) — modo desenvolvimento
# Se estiver PREENCHIDO -> usa PostgreSQL na nuvem (Neon) — modo produção 24/7
# Crie um banco grátis em https://neon.tech e cole a connection string aqui.
# (Opcional: adicione ?sslmode=require ao final)
DATABASE_URL=

# ---------- Servidor Web ----------
# Porta HTTP (3000 local; no Render a porta é definida por eles)
PORT=3000

# Segredo para assinar os tokens JWT (troque em produção!)
JWT_SECRET=

# URL pública exibida nos botões do Telegram (HTTPS obrigatório)
# Ex: https://gerador-painel.onrender.com
PUBLIC_BASE_URL=

# ---------- Keep-alive (Render gratuito) ----------
# Intervalo em minutos do ping no /health para o serviço não "dormir".
# 0 desliga o keep-alive.
KEEP_ALIVE_INTERVAL_MINUTES=5